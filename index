<div id="app"><p class="hint">Verbinde …</p></div>
<div id="toast" class="toast" role="status" hidden></div>
<script src="https://cdn.jsdelivr.net/npm/qrcode-generator@1.4.4/qrcode.js"></script>
<script>
(function(){
'use strict';
const DEFAULT_LINK='https://claude.ai/artifact/BUviT9BUQU7m4BFu6TFFfL';
const $=(s,r=document)=>r.querySelector(s);
const $$=(s,r=document)=>[...r.querySelectorAll(s)];
const esc=s=>String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const L=i=>String.fromCharCode(65+i);
const PH={idle:0,open:1,closed:2,results:3,locked:4,solved:5,end:6};
const S={db:null,assets:null,uid:null,isTeacher:false,canWrite:null,readOnly:false,noDb:false,mode:'student',
  session:null,questions:[],results:null,settings:null,answers:[],simIds:[],mine:null,mineLocal:null,
  editing:false,sound:true,reveal:0,lockStage:'none',solveStage:'none',animating:false,timers:[],
  lastKey:null,lastPhase:null,lastRound:null,sig:'',busy:false,sRound:null,optKey:null,draftQs:[],pendingAnim:null};
const cur=()=>S.session||{idx:-1,round:0,phase:'idle',q:'',total:0,type:'text',opts:[],img:null,solution:null,accept:null};
const qrLink=()=>(S.settings&&S.settings.link)||DEFAULT_LINK;

/* ---------- Text, Gruppen, Prozente ---------- */
function normText(s){
  s=String(s||'').toLowerCase().replace(/ä/g,'ae').replace(/ö/g,'oe').replace(/ü/g,'ue').replace(/ß/g,'ss');
  s=s.normalize('NFD').replace(/[̀-ͯ]/g,'').replace(/[^a-z0-9\s]/g,' ').replace(/\s+/g,' ').trim();
  const w=s.split(' ');
  if(w.length>1&&['der','die','das','ein','eine','den','dem'].includes(w[0]))w.shift();
  return w.join(' ');
}
function lev(a,b){
  if(a===b)return 0;
  let p=Array.from({length:b.length+1},(_,i)=>i);
  for(let i=1;i<=a.length;i++){
    const c=[i];
    for(let j=1;j<=b.length;j++)c[j]=Math.min(p[j]+1,c[j-1]+1,p[j-1]+(a[i-1]===b[j-1]?0:1));
    p=c;
  }
  return p[b.length];
}
const tol=n=>n>=9?2:n>=5?1:0;
const same=(a,b)=>a===b||lev(a,b)<=Math.min(tol(a.length),tol(b.length));
function buildClusters(list){
  const items=list.map(a=>({raw:String(a.text).trim(),key:normText(a.text)})).filter(i=>i.key);
  const freq=new Map();
  items.forEach(i=>freq.set(i.key,(freq.get(i.key)||0)+1));
  const keys=[...freq.entries()].sort((a,b)=>b[1]-a[1]||a[0].localeCompare(b[0])).map(e=>e[0]);
  const cl=[];
  keys.forEach(k=>{
    const hit=cl.find(c=>same(c.key,k));
    if(hit){hit.keys.add(k);hit.count+=freq.get(k)}
    else cl.push({key:k,keys:new Set([k]),count:freq.get(k),labels:new Map()});
  });
  items.forEach(i=>{
    const c=cl.find(c=>c.keys.has(i.key));
    c.labels.set(i.raw,(c.labels.get(i.raw)||0)+1);
  });
  cl.forEach(c=>{c.label=[...c.labels.entries()].sort((a,b)=>b[1]-a[1])[0][0]});
  cl.sort((a,b)=>b.count-a.count||a.label.localeCompare(b.label));
  return {clusters:cl,total:items.length};
}
function pcts(counts,total){
  const raw=counts.map(c=>c*100/total),fl=raw.map(Math.floor);
  let rest=100-fl.reduce((a,b)=>a+b,0);
  raw.map((v,i)=>[v-fl[i],i]).sort((a,b)=>b[0]-a[0]).forEach(([,i])=>{if(rest>0){fl[i]++;rest--}});
  return fl;
}
const splitAlts=s=>String(s||'').split(/[|;]/).map(x=>x.trim()).filter(Boolean);
const matches=(text,accept)=>{const k=normText(text);return !!k&&(accept||[]).some(a=>same(k,normText(a)))};
function validAnswer(a){
  const s=cur();
  if(a.round!==s.round)return false;
  if(s.type==='mc')return Number.isInteger(a.choice)&&a.choice>=0&&a.choice<(s.opts||[]).length;
  return !!a.text;
}
const answersForRound=()=>S.answers.filter(validAnswer);
function rowsData(){
  const s=cur(),r=S.results;
  if(!r||r.round!==s.round||!r.total)return [];
  let rows;
  if(r.type==='mc'){
    rows=r.clusters.map(c=>({label:c.label,count:c.count,idx:c.idx,keys:[]}));
  }else{
    const MAX=6,cl=r.clusters,head=cl.slice(0,MAX),rest=cl.slice(MAX);
    rows=head.map(c=>({label:c.label,count:c.count,keys:c.keys||[]}));
    if(rest.length)rows.push({label:'Weitere ('+rest.length+')',count:rest.reduce((a,c)=>a+c.count,0),keys:[],other:true});
  }
  const p=pcts(rows.map(x=>x.count),r.total);
  const max=Math.max(...rows.filter(x=>!x.other).map(x=>x.count));
  const acc=s.accept||[],accN=r.type==='mc'?[]:acc.map(normText);
  rows.forEach((x,i)=>{
    x.pct=p[i];
    x.top=!x.other&&x.count===max;
    x.correct=!!s.accept&&!x.other&&(r.type==='mc'?acc.includes(x.idx):x.keys.some(k=>accN.some(a=>same(k,a))));
  });
  return rows;
}
function verdict(){
  const rows=rowsData();
  const tops=rows.filter(r=>r.top),cp=rows.filter(r=>r.correct).reduce((a,r)=>a+r.pct,0);
  const share=cp>0?cp+' % hatten die richtige Lösung.':'Niemand hatte die richtige Lösung.';
  if(tops.length>1){
    const has=tops.some(r=>r.correct);
    return {ok:has,text:'Gleichstand. Die richtige Antwort war '+(has?'dabei.':'nicht dabei.'),sub:share};
  }
  const ok=!!(tops[0]&&tops[0].correct);
  return {ok,text:ok?'Die Klasse lag richtig.':'Die Klasse lag daneben.',sub:ok?'':share};
}

/* ---------- QR-Code ---------- */
function qrSvg(text){
  try{
    if(typeof qrcode!=='function')return '';
    const q=qrcode(0,'M');q.addData(text);q.make();
    const n=q.getModuleCount(),m=3;let d='';
    for(let r=0;r<n;r++)for(let c=0;c<n;c++)if(q.isDark(r,c))d+='M'+c+' '+r+'h1v1h-1z';
    const w=n+2*m;
    return '<svg xmlns="http://www.w3.org/2000/svg" viewBox="'+(-m)+' '+(-m)+' '+w+' '+w+'" shape-rendering="crispEdges" role="img" aria-label="QR-Code zur Seite">'
      +'<rect x="'+(-m)+'" y="'+(-m)+'" width="'+w+'" height="'+w+'" fill="#ffffff"/><path d="'+d+'" fill="#000000"/></svg>';
  }catch(e){return ''}
}
const qrFallback='<p class="hint">Der QR-Code konnte nicht geladen werden. Der Link steht darunter.</p>';
function showQR(){
  if($('#qrov'))return;
  const link=qrLink(),o=document.createElement('div');
  o.className='overlay';o.id='qrov';
  o.innerHTML='<div class="ovbox"><div class="qrsvg big" id="qrbig">'+(qrSvg(link)||qrFallback)+'</div>'
   +'<div class="eyebrow">Zum Mitmachen scannen</div>'
   +'<label for="qrlink">Link zur Seite<input id="qrlink" value="'+esc(link)+'" autocomplete="off"></label>'
   +'<div class="controls" style="justify-content:flex-start;padding-top:0"><button class="btn" data-act="qrsave" type="button">Link übernehmen</button>'
   +'<button class="btn primary" data-act="qrclose" type="button">Schließen</button></div></div>';
  document.body.appendChild(o);
}
function closeQR(){const o=$('#qrov');if(o)o.remove()}
async function saveLink(){
  const v=($('#qrlink').value||'').trim();
  if(!/^https:\/\/\S+$/.test(v)){toast('Bitte einen vollständigen Link mit https:// eingeben.');return}
  S.settings=Object.assign({},S.settings,{link:v});
  const big=$('#qrbig');if(big)big.innerHTML=qrSvg(v)||qrFallback;
  S.sig='';if(S.mode==='present')drawPresenter();
  try{await S.db.doc('teacher/settings').set({link:v});toast('Link gespeichert.')}
  catch(e){toast('Der Link konnte nicht gespeichert werden.')}
}

/* ---------- Ton ---------- */
let ac=null;
function actx(){
  if(!S.sound)return null;
  try{ac=ac||new (window.AudioContext||window.webkitAudioContext)();if(ac.state==='suspended')ac.resume()}catch(e){ac=null}
  return ac;
}
function tone(f,d,type,g,delay){
  const a=actx();if(!a)return;
  try{
    const o=a.createOscillator(),v=a.createGain(),t=a.currentTime+(delay||0);
    o.type=type||'sine';o.frequency.value=f;
    v.gain.setValueAtTime(.0001,t);v.gain.exponentialRampToValueAtTime(g||.07,t+.012);v.gain.exponentialRampToValueAtTime(.0001,t+d);
    o.connect(v);v.connect(a.destination);o.start(t);o.stop(t+d+.03);
  }catch(e){}
}
function drumroll(){let t=0,gap=.26;while(t<2.7){tone(130+Math.random()*30,.08,'triangle',.1,t);t+=gap;gap=Math.max(.055,gap*.86)}}
function lockSound(){tone(80,.5,'sine',.2);tone(392,.6,'triangle',.07);tone(587,.6,'triangle',.06,.02);tone(784,.7,'triangle',.05,.04)}
function verdictSound(ok){
  if(ok){[523,659,784,1047].forEach((f,i)=>tone(f,.3,'triangle',.08,i*.12))}
  else{tone(220,.35,'sawtooth',.05);tone(165,.6,'sawtooth',.05,.3)}
}

/* ---------- Timer und Animation ---------- */
function later(fn,ms){S.timers.push(setTimeout(fn,ms))}
function clearTimers(){S.timers.forEach(clearTimeout);S.timers=[]}
function countUp(el,to,ms){
  if(!el)return;
  const t0=performance.now();
  (function f(n){const p=Math.min(1,(n-t0)/ms);el.textContent=Math.round(to*(1-Math.pow(1-p,3)));if(p<1)requestAnimationFrame(f)})(t0);
}
function paint(){
  const st=$('.stage');
  if(st){
    st.dataset.lock=S.lockStage;st.dataset.solve=S.solveStage;
    const rows=$$('.row',st),R=rows.length;
    rows.forEach((li,i)=>li.classList.toggle('on',(R-1-i)<S.reveal));
  }
  updateButtons();
}
function labelFor(s){
  if(S.animating)return 'Überspringen';
  return {idle:S.questions.length?'Quiz starten':'Fragen anlegen',open:'Antworten schließen',closed:'Prozente zeigen',results:'Antwort einloggen',
    locked:'Lösung zeigen',solved:(s.idx+1<(S.questions.length||s.total)?'Nächste Frage':'Zum Abschluss'),end:'Von vorn'}[s.phase]||'Weiter';
}
function updateButtons(){
  const s=cur(),p=$('#primary'),b=$('#back');
  if(p){p.textContent=labelFor(s);p.disabled=false}
  if(b)b.hidden=!({closed:1,results:1,locked:1,solved:1}[s.phase])||S.animating;
}
function setFinalStates(s){
  S.animating=false;
  S.reveal=PH[s.phase]>=PH.results&&s.phase!=='end'?99:0;
  S.lockStage=PH[s.phase]>=PH.locked&&s.phase!=='end'?'done':'none';
  S.solveStage=s.phase==='solved'?'show':'none';
}
function startReveal(){
  const R=$$('.row').length;
  if(!R){later(startReveal,250);return}
  S.animating=true;S.reveal=0;paint();
  let t=600;
  for(let k=1;k<=R;k++){
    const last=k===R;
    if(last){
      t+=1400;
      [1100,700,350].forEach(d=>later(()=>tone(240,.06,'square',.04),t-d));
    }
    (function(k,t,last){later(()=>{
      S.reveal=k;paint();
      const row=$$('.row')[R-k];
      if(row)countUp($('.pctn',row),+row.dataset.pct,900);
      tone(300+k*55,.18,'triangle',.07);
      if(last){tone(660,.25,'triangle',.08);tone(880,.35,'triangle',.07,.12);S.animating=false;updateButtons()}
    },t)})(k,t,last);
    t+=850;
  }
}
function startLock(){
  S.animating=true;S.lockStage='drum';paint();drumroll();
  later(()=>{S.lockStage='done';S.animating=false;paint();lockSound()},3000);
}
function startSolve(){
  S.animating=true;S.solveStage='hold';paint();tone(180,.4,'sine',.1);
  later(()=>{S.solveStage='show';S.animating=false;paint();verdictSound(verdict().ok)},1500);
}
function finishAnim(){
  clearTimers();
  setFinalStates(cur());
  $$('.row').forEach(li=>{$('.pctn',li).textContent=li.dataset.pct});
  paint();
}
function onSession(){
  const s=cur(),key=s.round+':'+s.phase;
  if(key!==S.lastKey){
    const first=S.lastKey===null,pp=S.lastPhase,pr=S.lastRound;
    S.lastKey=key;S.lastPhase=s.phase;S.lastRound=s.round;
    clearTimers();
    setFinalStates(s);
    S.pendingAnim=(!first&&S.mode==='present'&&s.round===pr&&PH[s.phase]>PH[pp])?s.phase:null;
  }
  refresh();
}
function runPendingAnim(){
  const a=S.pendingAnim;S.pendingAnim=null;
  if(a==='results'){S.reveal=0;paint();later(startReveal,50)}
  else if(a==='locked')startLock();
  else if(a==='solved')startSolve();
  else paint();
}

/* ---------- Schreiben ---------- */
function toast(msg){
  const t=$('#toast');t.textContent=msg;t.hidden=false;
  clearTimeout(toast.t);toast.t=setTimeout(()=>{t.hidden=true},3600);
}
async function setSession(patch){
  if(S.busy||!S.db)return false;
  S.busy=true;
  const s=cur();
  const next=Object.assign({idx:s.idx==null?-1:s.idx,round:s.round||0,phase:s.phase||'idle',q:s.q||'',total:s.total||0,
    type:s.type||'text',opts:s.opts||[],img:s.img||null,solution:s.solution==null?null:s.solution,accept:s.accept||null},patch);
  try{await S.db.doc('session/main').set(next);return true}
  catch(e){toast('Das hat nicht geklappt. Bitte noch einmal versuchen.');return false}
  finally{S.busy=false}
}
async function startQuestion(i){
  const q=S.questions[i];if(!q)return;
  const mc=q.type==='mc';
  await setSession({idx:i,round:(cur().round||0)+1,phase:'open',q:q.q,total:S.questions.length,
    type:mc?'mc':'text',opts:mc?q.opts:[],img:q.img||null,solution:null,accept:null});
}
async function advance(){
  const s=cur(),Lq=S.questions;
  if(s.phase==='idle'||s.phase==='end'){
    if(!Lq.length){openEditor();return}
    return startQuestion(0);
  }
  if(s.phase==='open'){
    let doc;
    if(s.type==='mc'){
      const counts=(s.opts||[]).map(()=>0);
      answersForRound().forEach(a=>{counts[a.choice]++});
      const total=counts.reduce((a,b)=>a+b,0);
      if(!total){toast('Es sind noch keine Antworten eingegangen.');return}
      doc={round:s.round,type:'mc',total,clusters:counts.map((c,i)=>({label:L(i)+' · '+s.opts[i],count:c,idx:i})).sort((a,b)=>b.count-a.count||a.idx-b.idx)};
    }else{
      const g=buildClusters(answersForRound());
      if(!g.total){toast('Es sind noch keine Antworten eingegangen.');return}
      doc={round:s.round,type:'text',total:g.total,clusters:g.clusters.map(c=>({label:c.label,count:c.count,keys:[...c.keys]}))};
    }
    try{await S.db.doc('teacher/results').set(doc)}
    catch(e){toast('Die Auswertung konnte nicht gespeichert werden.');return}
    return setSession({phase:'closed'});
  }
  if(s.phase==='closed')return setSession({phase:'results'});
  if(s.phase==='results')return setSession({phase:'locked'});
  if(s.phase==='locked'){
    const item=Lq[s.idx]||{};
    if(s.type==='mc'){
      const c=Number.isInteger(item.correct)&&item.correct<(s.opts||[]).length?item.correct:0;
      return setSession({phase:'solved',solution:L(c)+' · '+(s.opts||[])[c],accept:[c]});
    }
    const alts=splitAlts(item.a);
    return setSession({phase:'solved',solution:alts[0]||'',accept:alts});
  }
  if(s.phase==='solved'){
    if(s.idx+1<Lq.length)return startQuestion(s.idx+1);
    return setSession({phase:'end',q:'',img:null,type:'text',opts:[],solution:null,accept:null});
  }
}
async function back(){
  const s=cur(),p={closed:'open',results:'closed',locked:'results',solved:'locked'}[s.phase];
  if(!p||S.busy)return;
  await setSession({phase:p,solution:null,accept:null});
}
function onPrimary(){if(S.animating){finishAnim();return}advance()}

async function simulate(){
  const s=cur(),item=S.questions[s.idx];
  if(!item||s.phase!=='open')return;
  const r=(a,b)=>a+Math.floor(Math.random()*(b-a+1));
  const docs=[];
  if(s.type==='mc'){
    const c=Number.isInteger(item.correct)?item.correct:0;
    (s.opts||[]).forEach((o,i)=>{const n=i===c?r(5,9):r(0,7);for(let k=0;k<n;k++)docs.push({round:s.round,choice:i,text:o})});
  }else{
    const sol=splitAlts(item.a)[0]||'42',typo=sol.length>3?sol.slice(0,-1)+sol.slice(-1)+sol.slice(-1):sol+' ';
    const pool=['weiß nicht','keine Ahnung','vielleicht','42','Ja','Nein','Das ist schwer'];
    const d1=pool[Math.floor(Math.random()*pool.length)];
    let d2=pool[Math.floor(Math.random()*pool.length)];if(d2===d1)d2='ich glaube nicht';
    [[sol,r(5,9)],[typo,r(1,2)],[d1,r(3,8)],[d2,r(1,4)]].forEach(([t,n])=>{for(let i=0;i<n;i++)docs.push({round:s.round,text:t})});
  }
  try{
    for(let i=0;i<docs.length;i+=5){
      await Promise.all(docs.slice(i,i+5).map((d,j)=>S.db.doc('answers/sim-'+(i+j+1)).set(Object.assign({t:Date.now()},d))));
    }
    toast('Test-Antworten eingefügt.');
  }catch(e){toast('Test-Antworten konnten nicht angelegt werden.')}
}
async function unsimulate(){
  const ids=S.simIds.slice();
  try{for(const id of ids)await S.db.doc('answers/'+id).delete();toast('Test-Antworten entfernt.')}
  catch(e){toast('Entfernen hat nicht geklappt.')}
}

