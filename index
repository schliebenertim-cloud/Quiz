  const sig=S.editing?'edit':[s.phase,s.round,s.idx,s.q,s.total,s.type,s.img,s.solution,S.questions.map(q=>q.q+'|'+q.a+'|'+q.type).join('¦'),resSig,S.simIds.length,qrLink()].join('~');
