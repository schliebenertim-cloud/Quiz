function mineNow(){
  const r=cur().round;
  const c=[S.mine,S.mineLocal].filter(x=>x&&x.round===r);
  if(!c.length)return null;
  return c.sort((a,b)=>(b.t||0)-(a.t||0))[0];
}
function paintStudent(){
  const s=cur(),f=$('#sf');if(!f)return;
  const m=mineNow(),sq=$('#sq'),msg=$('#smsg'),sol=$('#ssol'),inp=$('#ans'),btn=$('#sbtn'),opts=$('#sopts'),img=$('#simg');
  const mc=s.type==='mc';
  if(S.sRound!==s.round){S.sRound=s.round;inp.value='';S.optKey=null}
  const q=!!s.q&&s.phase!=='idle'&&s.phase!=='end';
  $('#sno').textContent=q?'Frage '+(s.idx+1)+' von '+s.total:'';
  sq.textContent=q?s.q:'';
  if(q&&s.img){const src='/_blob/'+s.img;if(img.getAttribute('src')!==src)img.src=src;img.hidden=false}else img.hidden=true;
  sol.style.display='none';
  let text='',showForm=false,showOpts=false;
  if(S.noDb)text='Zum Mitmachen musst du bei Claude angemeldet sein und die Seite dort öffnen.';
  else if(!S.uid)text='Zum Mitmachen musst du bei Claude angemeldet sein.';
  else if(S.canWrite===false||S.readOnly)text='Du kannst hier nur zuschauen. Bitte deine Lehrkraft, dich als Mitwirkende freizugeben.';
  else if(s.phase==='idle')text='Gleich geht’s los. Die Frage erscheint hier.';
  else if(s.phase==='end')text='Das war’s. Danke fürs Mitmachen.';
  else if(s.phase==='open'){
    if(mc){showOpts=true;text=m?'Gesendet: <b>'+esc(m.text)+'</b>. Du kannst noch wechseln.':'Tippe auf deine Antwort.'}
    else{
      showForm=true;
      text=m?'Gesendet: <b>'+esc(m.text)+'</b>. Du kannst sie noch ändern.':'Tippe deine Antwort ein.';
      btn.textContent=m?'Antwort ändern':'Antwort senden';
    }
  }else if(s.phase==='solved'){
    sol.style.display='block';
    $('#ssolt').textContent=s.solution||'';
    const v=$('#sver');
    if(m){
      const ok=mc?Number.isInteger(m.choice)&&(s.accept||[]).includes(m.choice):matches(m.text,s.accept);
      v.className='verdict '+(ok?'ok':'bad');v.textContent=ok?'Deine Antwort war richtig.':'Deine Antwort war nicht dabei.';
    }else{v.className='verdict';v.textContent=''}
  }else{
    text='Alle Antworten sind da. Schau nach vorn.'+(m?'<br>Deine Antwort: <b>'+esc(m.text)+'</b>':'');
  }
  opts.hidden=!showOpts;
  if(showOpts){
    if(S.optKey!==s.round){
      opts.innerHTML=(s.opts||[]).map((o,i)=>'<button type="button" class="opt" data-choice="'+i+'" aria-pressed="false"><span class="let">'+L(i)+'</span><span>'+esc(o)+'</span></button>').join('');
      S.optKey=s.round;
    }
    $$('.opt',opts).forEach(b=>b.setAttribute('aria-pressed',String(!!m&&m.choice===+b.dataset.choice)));
  }
  f.hidden=!showForm;
  msg.innerHTML=text;msg.hidden=!text;
}
async function writeAnswer(data){
  const s=cur();
  try{
    const t=Date.now();
    await S.db.doc('answers/'+S.uid).set(Object.assign({round:s.round,t},data));
    S.mineLocal=Object.assign({round:s.round,t},data);
    return true;
  }catch(e){
    if(e&&e.code==='invalid_argument')S.readOnly=true;
    else toast('Das Senden hat nicht geklappt. Bitte noch einmal versuchen.');
    return false;
  }
}
async function sendAnswer(){
  const s=cur(),inp=$('#ans'),btn=$('#sbtn'),v=inp.value.trim().slice(0,80);
  if(!v||s.phase!=='open'||s.type==='mc'||!S.uid||!S.db)return;
  btn.disabled=true;
  if(await writeAnswer({text:v}))inp.value='';
  btn.disabled=false;paintStudent();
}
async function sendChoice(i){
  const s=cur();
  if(s.phase!=='open'||s.type!=='mc'||!S.uid||!S.db||!(s.opts||[])[i])return;
  await writeAnswer({choice:i,text:s.opts[i]});
  paintStudent();
}

/* ---------- Steuerung ---------- */
function refresh(){
  if(S.mode==='present')drawPresenter();else paintStudent();
}
function mount(){
  clearTimers();S.sig='';
  if(S.mode==='present'){
    const s=cur();
    S.lastKey=s.round+':'+s.phase;S.lastPhase=s.phase;S.lastRound=s.round;
    setFinalStates(s);S.pendingAnim=null;
    drawPresenter();
  }else mountStudent();
}
document.addEventListener('click',e=>{
  const o=e.target.closest('.opt');
  if(o){sendChoice(+o.dataset.choice);return}
  if(e.target.id==='qrov'){closeQR();return}
  const b=e.target.closest('[data-act]');if(!b)return;
  const a=b.dataset.act;
  if(a==='primary')onPrimary();
  else if(a==='back')back();
  else if(a==='edit')openEditor();
  else if(a==='qr')showQR();
  else if(a==='qrclose')closeQR();
  else if(a==='qrsave')saveLink();
  else if(a==='sim')simulate();
  else if(a==='unsim')unsimulate();
  else if(a==='sound'){S.sound=!S.sound;b.textContent='Ton '+(S.sound?'an':'aus');b.setAttribute('aria-pressed',S.sound);if(S.sound)tone(660,.12,'triangle',.06)}
  else if(a==='full'){try{const p=document.documentElement.requestFullscreen&&document.documentElement.requestFullscreen();if(p&&p.catch)p.catch(()=>toast('Vollbild geht hier nicht. Nutze F11 im Browser.'))}catch(x){toast('Vollbild geht hier nicht. Nutze F11 im Browser.')}}
  else if(a==='student'){S.mode='student';mount()}
  else if(a==='present'){S.mode='present';mount()}
  else if(a==='addq'){S.draftQs=collectQs(true);S.draftQs.push({q:'',a:''});$('#app').innerHTML=bar()+editorHTML()}
  else if(a==='delq'){b.closest('.qrow').remove()}
  else if(a==='addopt'){
    const box=$('.opts-ed',b.closest('.mcbox'));
    if($$('.optrow',box).length>=6){toast('Es sind höchstens sechs Antwortmöglichkeiten möglich.');return}
    box.insertAdjacentHTML('beforeend',optRowHTML(box.dataset.q,'',false));
  }
  else if(a==='delopt'){
    const box=b.closest('.opts-ed');
    if($$('.optrow',box).length<=2){toast('Mindestens zwei Antwortmöglichkeiten bleiben stehen.');return}
    b.closest('.optrow').remove();
  }
  else if(a==='pickimg'){const fi=$('.fi',b.closest('.qrow'));if(fi)fi.click()}
  else if(a==='delimg'){const li=b.closest('.qrow');li.dataset.img='';$('.imgbox',li).innerHTML=imgHTML('')}
  else if(a==='cancel'){S.editing=false;S.sig='';drawPresenter()}
  else if(a==='saveq')saveQs();
});
document.addEventListener('change',e=>{
  const t=e.target;if(!t.classList)return;
  if(t.classList.contains('qt'))t.closest('.qrow').dataset.type=t.value==='mc'?'mc':'text';
  else if(t.classList.contains('fi')){const f=t.files&&t.files[0],li=t.closest('.qrow');if(f)uploadFor(li,f)}
});
document.addEventListener('paste',e=>{
  if(!S.editing||!e.target.closest)return;
  const li=e.target.closest('.qrow');if(!li)return;
  const f=[...(e.clipboardData?e.clipboardData.files:[])].find(x=>/^image\//.test(x.type));
  if(f){e.preventDefault();uploadFor(li,f)}
});
document.addEventListener('dragover',e=>{if(S.editing&&e.target.closest&&e.target.closest('.qrow'))e.preventDefault()});
document.addEventListener('drop',e=>{
  if(!S.editing||!e.target.closest)return;
  const li=e.target.closest('.qrow');if(!li)return;
  e.preventDefault();
  const f=e.dataTransfer&&e.dataTransfer.files&&e.dataTransfer.files[0];
  if(f)uploadFor(li,f);
});
document.addEventListener('keydown',e=>{
  if(e.key==='Escape'&&$('#qrov')){closeQR();return}
  if(S.mode!=='present'||S.editing||$('#qrov'))return;
  if(/INPUT|TEXTAREA|SELECT|BUTTON/.test(e.target.tagName))return;
  if(e.code==='Space'||e.key==='Enter'||e.key==='ArrowRight'){e.preventDefault();onPrimary()}
  else if(e.key==='ArrowLeft')back();
});

async function init(){
  const api=window.claude;
  if(!api||!api.use){S.noDb=true;S.mode='student';mount();return}
  let user=null,db=null;
  try{user=await api.use('user')}catch(e){}
  try{db=await api.use('db')}catch(e){}
  S.db=db;
  if(user){
    try{S.isTeacher=await user.canEdit();S.uid=await user.id();S.canWrite=await user.can('data.write')}catch(e){}
  }
  S.mode=S.isTeacher?'present':'student';
  if(!db){S.noDb=true;S.mode='student';mount();return}
  if(S.isTeacher){try{S.assets=await api.use('assets')}catch(e){}}
  mount();
  const err=()=>{};
  db.doc('session/main').onSnapshot(snap=>{S.session=snap.exists?snap.data():null;onSession()},err);
  if(S.uid)db.doc('answers/'+S.uid).onSnapshot(snap=>{S.mine=snap.exists?snap.data():null;if(S.mode==='student')paintStudent()},err);
  if(S.isTeacher){
    db.doc('teacher/questions').onSnapshot(snap=>{
      const d=snap.exists?snap.data():null;
      S.questions=d&&Array.isArray(d.list)?d.list:[];
      refresh();
    },err);
    db.doc('teacher/results').onSnapshot(snap=>{S.results=snap.exists?snap.data():null;refresh()},err);
    db.doc('teacher/settings').onSnapshot(snap=>{S.settings=snap.exists?snap.data():null;refresh()},err);
    db.collection('answers').onSnapshot(snap=>{
      S.answers=snap.docs.map(d=>Object.assign({id:d.id},d.data()));
      S.simIds=S.answers.filter(a=>a.id.indexOf('sim-')===0).map(a=>a.id);
      refresh();
    },err);
  }
}
init();
})();
</script>

